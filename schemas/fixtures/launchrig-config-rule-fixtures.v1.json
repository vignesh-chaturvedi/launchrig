{
  "schemaVersion": 1,
  "kind": "launchrig-config-rule-fixtures",
  "profile": "config-rules-v1",
  "status": "pre-award-foundation",
  "ruleIds": ["LR001", "LR002", "LR003", "LR004", "LR005"],
  "caseCount": 10,
  "grantMilestoneComplete": false,
  "base": {
    "version": 1,
    "project": {
      "name": "Rule fixture",
      "packageName": "com.example.rulefixture",
      "apk": "./app.apk",
      "install": false
    },
    "target": {
      "network": "devnet"
    },
    "device": {
      "requirePhysical": true,
      "minimumApiLevel": 26
    },
    "wallet": {
      "mode": "mock-mwa",
      "packageName": "com.solana.mwallet",
      "apk": "./wallet.apk",
      "install": false
    },
    "scenarios": [
      {
        "id": "authorize",
        "kind": "custom",
        "name": "Safe local fixture",
        "flow": "./flow.yaml"
      }
    ],
    "artifacts": {
      "directory": "./.launchrig/results",
      "screenshots": "failure",
      "retention": 5
    },
    "privacy": {
      "includeLogcat": false,
      "logcatLines": 200,
      "redactPatterns": []
    },
    "tooling": {}
  },
  "baseFiles": {
    "app.apk": "fixture-app-bytes",
    "wallet.apk": "fixture-wallet-bytes",
    "flow.yaml": "appId: com.example.rulefixture\n---\n- launchApp\n- assertVisible: Ready\n"
  },
  "cases": [
    {
      "id": "all-rules-pass",
      "targetRule": "LR001",
      "set": {},
      "remove": [],
      "omitFiles": [],
      "replaceFiles": {},
