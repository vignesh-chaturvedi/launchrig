{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrig.dev/schemas/launchrig-private-send-decision-request-result.schema.json",
  "title": "LaunchRig private send decision request result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profile",
    "status",
    "claimStatus",
    "reviewSetCompleteness",
    "conflictStatus",
    "latestStatus",
    "preparationStatus",
    "humanRelatedReviewSetConfirmed",
    "humanSendDecisionRecorded",
    "humanAuthorizerAuthenticated",
    "requestFileSha256",
    "requestContentSha256",
    "selectedReviewFileSha256",
    "selectedReviewContentSha256",
    "prospectFileSha256",
    "draftFileSha256",
    "reviewSetCount",
    "reviewSetSha256",
    "sourceRecheck",
    "routeRecheck",
    "relationshipDisclosureRecheck",
    "compensationDisclosureRecheck",
    "safetyRecheck",
    "contact",
    "sendAuthorization",
    "messageDispatched",
    "lifecycle",
    "candidateCreated",
    "interestRecorded",
    "projectModificationAuthorized",
    "phoneAccessAuthorized",
    "pilotStateChecked",
    "deviceEnvironmentChecked",
    "publisherIdentity",
    "publisherAuthority",
    "publisherConsent",
    "publisherIndependence",
    "externalGrantGate",
    "grantReady",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "launchrig-private-send-decision-request-result" },
    "profile": { "const": "phase-2m-send-decision-preparation-v1" },
    "status": { "const": "created" },
    "claimStatus": { "const": "operator-prepared-unattested" },
    "reviewSetCompleteness": { "const": "operator-asserted-unattested" },
    "conflictStatus": { "const": "none-detected-in-operator-supplied-set" },
    "latestStatus": { "const": "not-established" },
    "preparationStatus": { "const": "awaiting-exact-human-send-decision" },
    "humanRelatedReviewSetConfirmed": { "const": true },
    "humanSendDecisionRecorded": { "const": false },
    "humanAuthorizerAuthenticated": { "const": false },
    "requestFileSha256": { "$ref": "#/$defs/hash" },
    "requestContentSha256": { "$ref": "#/$defs/hash" },
    "selectedReviewFileSha256": { "$ref": "#/$defs/hash" },
    "selectedReviewContentSha256": { "$ref": "#/$defs/hash" },
    "prospectFileSha256": { "$ref": "#/$defs/hash" },
    "draftFileSha256": { "$ref": "#/$defs/hash" },
    "reviewSetCount": { "const": 1 },
    "reviewSetSha256": { "$ref": "#/$defs/hash" },
    "sourceRecheck": { "const": "not-recorded" },
    "routeRecheck": { "const": "not-recorded" },
    "relationshipDisclosureRecheck": { "const": "not-recorded" },
    "compensationDisclosureRecheck": { "const": "not-recorded" },
    "safetyRecheck": { "const": "not-recorded" },
    "contact": { "const": "not-contacted" },
    "sendAuthorization": { "const": "not-authorized" },
    "messageDispatched": { "const": false },
    "lifecycle": { "const": "screening" },
    "candidateCreated": { "const": false },
    "interestRecorded": { "const": false },
    "projectModificationAuthorized": { "const": false },
    "phoneAccessAuthorized": { "const": false },
    "pilotStateChecked": { "const": false },
    "deviceEnvironmentChecked": { "const": false },
    "publisherIdentity": { "const": "not-established" },
    "publisherAuthority": { "const": "not-established" },
    "publisherConsent": { "const": "not-established" },
    "publisherIndependence": { "const": "not-established" },
    "externalGrantGate": { "const": "not-established" },
    "grantReady": { "const": false },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "limitations": {
      "const": [
        "This private request records an operator-supplied review set for exact prospect, draft, and review bytes. It does not authenticate the operator, reviewer, publisher, source, route, disclosure, or safety findings.",
        "Review-set completeness is an unattested operator assertion. No receipt is inferred to be latest, and any additional related receipt leaves the send decision unresolved.",
        "Preparation records no human send decision, grants no send authorization, performs no contact, and dispatches no message.",
        "Any change to the prospect, draft, selected review, or operator-supplied related review set invalidates this request and requires a new preparation.",
        "Source, route, relationship disclosure, compensation disclosure, and safety rechecks remain not recorded for the later exact human send decision.",
        "File ownership and mode checks do not prove ACL, backup, sync, process-list, shell-history, or cloud-storage privacy.",
        "Publisher identity, authority, consent, independence, external testing, confirmed defects, and grant readiness remain not established."
      ]
    }
  }
}
