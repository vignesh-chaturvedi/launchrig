{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrig.dev/schemas/launchrig-publisher-bundle.schema.json",
  "title": "LaunchRig publisher bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profile",
    "bundleId",
    "launchRigVersion",
    "source",
    "package",
    "consumerRehearsal",
    "sourceVerification",
    "claims",
    "scope",
    "grantReady",
    "files",
    "payloadSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "launchrig-publisher-bundle" },
    "profile": {
      "enum": [
        "phase-2a-publisher-rc-v1",
        "phase-2b-publisher-rc-v2",
        "phase-2c-publisher-rc-v3",
        "phase-3-foundation-rc-v4",
        "phase-3-config-parity-rc-v5",
        "phase-3-validation-action-rc-v6",
        "phase-2d-publisher-readiness-rc-v7",
        "phase-2e-consent-scope-rc-v8",
        "phase-2f-scope-enforced-pilot-rc-v9",
        "phase-2g-operational-contract-rc-v10",
        "phase-2h-consent-safe-scope-rc-v11",
        "phase-2i-recruitment-register-rc-v12",
        "phase-2l-human-prospect-review-rc-v13",
        "phase-2m-send-decision-preparation-rc-v14"
      ]
    },
    "bundleId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "launchRigVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "lockfileSha256", "worktree"],
      "properties": {
        "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "lockfileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "worktree": { "const": "clean" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sizeBytes", "sha256", "private", "nodeEngine", "packageManager"],
      "properties": {
        "name": { "const": "launchrig" },
        "path": { "$ref": "#/$defs/safePath" },
        "sizeBytes": { "$ref": "#/$defs/sizeBytes" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "private": { "const": true },
        "nodeEngine": { "type": "string", "minLength": 1, "maxLength": 40 },
        "packageManager": { "type": "string", "pattern": "^pnpm@[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "consumerRehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode", "checks", "deviceOrWalletTested"],
      "properties": {
        "status": { "const": "passed" },
        "mode": { "const": "clean-offline-pnpm-install" },
        "checks": {
          "type": "array"
        },
        "deviceOrWalletTested": { "const": false }
      }
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "const": "passed" },
        "checks": {
          "const": [
            "package-manager-version",
            "frozen-offline-dependency-restore",
            "typecheck",
            "test-suite",
            "package-smoke"
          ]
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalPublisher",
        "seekerHardware",
        "productionWallet",
        "seedVault",
        "confirmedDefect"
      ],
      "properties": {
        "externalPublisher": { "const": "not-established" },
        "seekerHardware": { "const": "not-established" },
        "productionWallet": { "const": "not-established" },
        "seedVault": { "const": "not-established" },
        "confirmedDefect": { "const": "not-established" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includesApks", "includesPrivatePilotState", "includesPublisherEvidence"],
      "properties": {
        "includesApks": { "const": false },
        "includesPrivatePilotState": { "const": false },
        "includesPublisherEvidence": { "const": false }
      }
    },
    "grantReady": { "const": false },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "sizeBytes": { "$ref": "#/$defs/sizeBytes" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "payloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": { "const": "phase-2m-send-decision-preparation-rc-v14" }
        }
      },
      "then": {
        "properties": {
          "consumerRehearsal": {
            "type": "object",
            "properties": {
              "checks": {
                "const": [
                  "offline-package-install",
                  "installed-version-match",
                  "installed-help-contract",
                  "pilot-timer-start",
                  "starter-generation",
                  "starter-validation",
                  "device-free-preflight-refusal",
                  "device-free-pilot-policy-lint-refusal",
                  "device-free-session-scope-receipt",
                  "device-free-approved-scope-enforcement",
                  "installed-scope-linked-governance-contract",
                  "device-free-consent-safe-scope-preparation",
                  "device-free-private-recruitment-register-preparation",
                  "device-free-private-prospect-review-confirmation-refusal",
                  "device-free-private-send-decision-preparation-confirmation-refusal"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "phase-2l-human-prospect-review-rc-v13" }
        }
      },
      "then": {
        "properties": {
          "consumerRehearsal": {
            "type": "object",
            "properties": {
              "checks": {
                "const": [
                  "offline-package-install",
                  "installed-version-match",
                  "installed-help-contract",
                  "pilot-timer-start",
                  "starter-generation",
                  "starter-validation",
                  "device-free-preflight-refusal",
                  "device-free-pilot-policy-lint-refusal",
                  "device-free-session-scope-receipt",
                  "device-free-approved-scope-enforcement",
                  "installed-scope-linked-governance-contract",
                  "device-free-consent-safe-scope-preparation",
                  "device-free-private-recruitment-register-preparation",
                  "device-free-private-prospect-review-confirmation-refusal"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "phase-2i-recruitment-register-rc-v12" }
        }
      },
      "then": {
        "properties": {
          "consumerRehearsal": {
            "type": "object",
            "properties": {
              "checks": {
                "const": [
                  "offline-package-install",
                  "installed-version-match",
                  "installed-help-contract",
                  "pilot-timer-start",
                  "starter-generation",
                  "starter-validation",
                  "device-free-preflight-refusal",
                  "device-free-pilot-policy-lint-refusal",
                  "device-free-session-scope-receipt",
                  "device-free-approved-scope-enforcement",
                  "installed-scope-linked-governance-contract",
                  "device-free-consent-safe-scope-preparation",
                  "device-free-private-recruitment-register-preparation"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "phase-2i-recruitment-register-rc-v12",
              "phase-2l-human-prospect-review-rc-v13",
              "phase-2m-send-decision-preparation-rc-v14"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "consumerRehearsal": {
            "type": "object",
            "properties": {
              "checks": { "type": "array" }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "profile": { "const": "phase-2h-consent-safe-scope-rc-v11" }
          }
        },
        "then": {
          "properties": {
            "consumerRehearsal": {
              "type": "object",
              "properties": {
                "checks": {
                  "const": [
                    "offline-package-install",
                    "installed-version-match",
                    "installed-help-contract",
                    "pilot-timer-start",
                    "starter-generation",
                    "starter-validation",
                    "device-free-preflight-refusal",
                    "device-free-pilot-policy-lint-refusal",
                    "device-free-session-scope-receipt",
                    "device-free-approved-scope-enforcement",
                    "installed-scope-linked-governance-contract",
                    "device-free-consent-safe-scope-preparation"
                  ]
                }
              }
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "profile": { "const": "phase-2g-operational-contract-rc-v10" }
            }
          },
          "then": {
            "properties": {
              "consumerRehearsal": {
                "type": "object",
                "properties": {
                  "checks": {
                    "const": [
                      "offline-package-install",
                      "installed-version-match",
                      "installed-help-contract",
                      "pilot-timer-start",
                      "starter-generation",
                      "starter-validation",
                      "device-free-preflight-refusal",
                      "device-free-pilot-policy-lint-refusal",
                      "device-free-session-scope-receipt",
                      "device-free-approved-scope-enforcement",
                      "installed-scope-linked-governance-contract"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "profile": { "const": "phase-2f-scope-enforced-pilot-rc-v9" }
              }
            },
            "then": {
              "properties": {
                "consumerRehearsal": {
                  "type": "object",
                  "properties": {
                    "checks": {
                      "const": [
                        "offline-package-install",
                        "installed-version-match",
                        "installed-help-contract",
                        "pilot-timer-start",
                        "starter-generation",
                        "starter-validation",
                        "device-free-preflight-refusal",
                        "device-free-pilot-policy-lint-refusal",
                        "device-free-session-scope-receipt",
                        "device-free-approved-scope-enforcement"
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "profile": { "const": "phase-2e-consent-scope-rc-v8" }
                }
              },
              "then": {
                "properties": {
                  "consumerRehearsal": {
                    "type": "object",
                    "properties": {
                      "checks": {
                        "const": [
                          "offline-package-install",
                          "installed-version-match",
                          "installed-help-contract",
                          "pilot-timer-start",
                          "starter-generation",
                          "starter-validation",
                          "device-free-preflight-refusal",
                          "device-free-pilot-policy-lint-refusal",
                          "device-free-session-scope-receipt"
                        ]
                      }
                    }
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "profile": { "const": "phase-2d-publisher-readiness-rc-v7" }
                  }
                },
                "then": {
                  "properties": {
                    "consumerRehearsal": {
                      "type": "object",
                      "properties": {
                        "checks": {
                          "const": [
                            "offline-package-install",
                            "installed-version-match",
                            "installed-help-contract",
                            "pilot-timer-start",
                            "starter-generation",
                            "starter-validation",
                            "device-free-preflight-refusal",
                            "device-free-pilot-policy-lint-refusal"
                          ]
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "consumerRehearsal": {
                      "type": "object",
                      "properties": {
                        "checks": {
                          "const": [
                            "offline-package-install",
                            "installed-version-match",
                            "installed-help-contract",
                            "pilot-timer-start",
                            "starter-generation",
                            "starter-validation",
                            "device-free-preflight-refusal"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\r\\n])[A-Za-z0-9._/-]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
  }
}
