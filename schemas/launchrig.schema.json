{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrig.dev/schemas/launchrig-v1.schema.json",
  "title": "LaunchRig configuration",
  "$comment": "Portable structural contract. The LaunchRig runtime additionally enforces unique scenario IDs and JavaScript regular-expression compilation as documented runtime extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "target", "device", "wallet", "scenarios", "artifacts", "privacy"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "packageName"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "packageName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
        "apk": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "install": { "type": "boolean", "default": false },
        "installPolicy": { "enum": ["always", "if-missing"], "default": "always" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network"],
      "properties": { "network": { "enum": ["devnet", "testnet"] } }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirePhysical": { "type": "boolean", "default": true },
        "minimumApiLevel": { "type": "integer", "minimum": 23, "maximum": 100, "default": 26 }
      }
    },
    "wallet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["mock-mwa", "reference-fakewallet", "real"] },
        "packageName": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "apk": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "install": { "type": "boolean", "default": false },
        "installPolicy": { "enum": ["always", "if-missing"], "default": "always" }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "flow"],
        "properties": {
          "id": { "type": "string", "pattern": "^(?!(?:none|selection)$)[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["mwa-authorize", "mwa-siws", "mwa-sign-message", "mwa-reject", "mwa-stale-authorization", "mwa-process-death", "custom"] },
          "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "flow": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "required": { "type": "boolean", "default": true },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 120000 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "screenshots": { "enum": ["failure", "always", "never"], "default": "failure" },
        "retention": { "type": "integer", "minimum": 1, "maximum": 25, "default": 5 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeLogcat": { "type": "boolean", "default": false },
        "logcatLines": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 },
        "redactPatterns": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "adb": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "maestro": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "project": { "properties": { "install": { "const": true } }, "required": ["install"] } } },
      "then": { "properties": { "project": { "required": ["apk"] } } }
    },
    {
      "if": { "properties": { "wallet": { "properties": { "install": { "const": true } }, "required": ["install"] } } },
      "then": {
        "properties": {
          "wallet": {
            "required": ["apk", "packageName"],
            "properties": {
              "packageName": {
                "enum": ["com.solana.mwallet", "com.solana.mobilewalletadapter.fakewallet"]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "wallet": { "properties": { "mode": { "const": "real" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "wallet": { "properties": { "install": { "const": false } } },
          "artifacts": { "properties": { "screenshots": { "const": "never" } }, "required": ["screenshots"] },
          "privacy": { "properties": { "includeLogcat": { "const": false } } },
          "scenarios": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project": {
            "properties": { "packageName": { "const": "com.solana.mobilewalletadapter.fakedapp" } },
            "required": ["packageName"]
          }
        }
      },
      "then": { "properties": { "target": { "properties": { "network": { "const": "testnet" } } } } }
    },
    {
      "if": { "properties": { "wallet": { "properties": { "mode": { "const": "mock-mwa" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "wallet": {
            "properties": { "packageName": { "const": "com.solana.mwallet" } },
            "required": ["packageName"]
          }
        }
      }
    },
    {
      "if": { "properties": { "wallet": { "properties": { "mode": { "const": "reference-fakewallet" } }, "required": ["mode"] } } },
      "then": {
        "properties": {
          "wallet": {
            "properties": { "packageName": { "const": "com.solana.mobilewalletadapter.fakewallet" } },
            "required": ["packageName"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenarios": {
            "contains": {
              "properties": { "kind": { "enum": ["mwa-authorize", "mwa-siws", "mwa-sign-message", "mwa-reject", "mwa-stale-authorization", "mwa-process-death"] } },
              "required": ["kind"]
            }
          }
        }
      },
      "then": { "properties": { "wallet": { "required": ["packageName"] } } }
    }
  ]
}
