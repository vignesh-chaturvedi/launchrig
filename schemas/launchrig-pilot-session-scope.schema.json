{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrig.dev/schemas/launchrig-pilot-session-scope.schema.json",
  "title": "LaunchRig private pilot session scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profile",
    "scopeRef",
    "operatorRef",
    "pilotRef",
    "deviceRef",
    "bundle",
    "inputs",
    "policy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "launchrig-pilot-session-scope" },
    "profile": { "const": "external-mwa-pilot-scope-v1" },
    "scopeRef": { "$ref": "#/$defs/scopeRef" },
    "operatorRef": { "$ref": "#/$defs/operatorRef" },
    "pilotRef": { "$ref": "#/$defs/pilotRef" },
    "deviceRef": { "$ref": "#/$defs/deviceRef" },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "manifestSha256", "sha256SumsSha256", "packageSha256"],
      "properties": {
        "bundleId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "sha256SumsSha256": { "$ref": "#/$defs/sha256" },
        "packageSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configSha256", "appBuildSha256", "walletArtifactSha256", "flows"],
      "properties": {
        "configSha256": { "$ref": "#/$defs/sha256" },
        "appBuildSha256": { "$ref": "#/$defs/sha256" },
        "walletArtifactSha256": { "$ref": "#/$defs/sha256" },
        "flows": {
          "type": "array",
          "$comment": "The CLI additionally requires pairwise-distinct scenarioId and fileSha256 values across the four flows.",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/flow" },
          "allOf": [
            { "contains": { "type": "object", "properties": { "kind": { "const": "mwa-authorize" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "type": "object", "properties": { "kind": { "const": "mwa-siws" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "type": "object", "properties": { "kind": { "const": "mwa-sign-message" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 },
            { "contains": { "type": "object", "properties": { "kind": { "const": "mwa-reject" } }, "required": ["kind"] }, "minContains": 1, "maxContains": 1 }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "walletMode",
        "physicalAndroidRequired",
        "attendedExecutionRequired",
        "manualWalletActionsRequired",
        "valuableAssetsAllowed",
        "capture",
        "retention",
        "sharing"
      ],
      "properties": {
        "network": { "enum": ["devnet", "testnet"] },
        "walletMode": { "enum": ["mock-mwa", "reference-fakewallet"] },
        "physicalAndroidRequired": { "const": true },
        "attendedExecutionRequired": { "const": true },
        "manualWalletActionsRequired": { "const": true },
        "valuableAssetsAllowed": { "const": false },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshots", "includeLogcat", "logcatLines"],
          "properties": {
            "screenshots": { "enum": ["failure", "always", "never"] },
            "includeLogcat": { "type": "boolean" },
            "logcatLines": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRuns", "expiresOn", "deletionMethod"],
          "properties": {
            "maxRuns": { "type": "integer", "minimum": 1, "maximum": 25 },
            "expiresOn": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "$comment": "The CLI additionally rejects impossible calendar dates."
            },
            "deletionMethod": {
              "enum": ["standard-delete", "secure-delete", "publisher-managed", "other-documented"]
            }
          }
        },
        "sharing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publicEvidenceJson",
            "sanitizedReports",
            "publisherName",
            "publisherLogo",
            "approvedQuote",
            "confirmedDefectRecord"
          ],
          "properties": {
            "publicEvidenceJson": { "type": "boolean" },
            "sanitizedReports": { "type": "boolean" },
            "publisherName": { "type": "boolean" },
            "publisherLogo": { "type": "boolean" },
            "approvedQuote": { "type": "boolean" },
            "confirmedDefectRecord": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scopeRef": { "type": "string", "pattern": "^urn:launchrig:scope:[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "operatorRef": { "type": "string", "pattern": "^urn:launchrig:operator:[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "pilotRef": { "type": "string", "pattern": "^urn:launchrig:pilot:[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "deviceRef": { "type": "string", "pattern": "^urn:launchrig:device:[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scenarioId", "fileSha256"],
      "properties": {
        "kind": { "enum": ["mwa-authorize", "mwa-siws", "mwa-sign-message", "mwa-reject"] },
        "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "fileSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
