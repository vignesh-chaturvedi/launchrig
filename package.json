{
  "name": "launchrig",
  "version": "0.1.0",
  "description": "A physical-device release test rig for Solana Mobile apps",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "launchrig": "dist/src/cli.js"
  },
  "files": [
    "action.yml",
    "action",
    "dist/src",
    "dist/node_modules/yaml",
    "schemas",
    "docs",
    "examples",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/vendor-runtime.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "prepack": "pnpm run build",
    "package:smoke": "node scripts/package-smoke.mjs",
    "pilot:bundle": "node scripts/pilot-bundle.mjs",
    "fixtures:fetch": "node scripts/fetch-mwa-fixtures.mjs",
    "fixtures:build-dapp": "node scripts/build-fixture-dapp.mjs",
    "fixtures:build-mock-wallet": "node scripts/build-mock-mwa-fixture.mjs",
    "results:sanitize": "node scripts/sanitize-results.mjs",
    "launchrig": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.34.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "8.17.1",
    "typescript": "^5.9.2",
    "yaml": "2.9.0"
  }
}
